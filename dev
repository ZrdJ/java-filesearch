#!/usr/bin/env bash
# java-filesearch — Entwickler-Einstiegspunkt.
#
# Container-aware: Laeuft dieses Skript ausserhalb des Devcontainers, re-exect es
# sich selbst hinein. Laeuft es bereits im Container (DEVCONTAINER=true), fuehrt es
# den Befehl direkt aus. Damit ist `./dev <cmd>` ueberall derselbe Aufruf und es
# gibt keinen Weg, versehentlich nativ zu bauen.
#
# Hintergrund: ~/.claude/docs/project/research/devcontainer-architektur.md
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")"

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

usage() {
	cat <<'USAGE'
java-filesearch Developer Commands

Usage: ./dev <command>

  build   Compile and package the jar, skipping tests (mvn package -DskipTests)
  test    Run the test suite (mvn test)
  check   test + the requirement <-> test chain (the gate CI mirrors)
  usage   Show this text
USAGE
}

if [ "${DEVCONTAINER:-}" != "true" ]; then
	if [ $# -eq 0 ]; then
		usage
		exit 0
	fi
	echo -e "${YELLOW}-> Ausserhalb des Containers, fuehre im Devcontainer aus...${NC}" >&2
	devcontainer up --workspace-folder . >/dev/null
	exec devcontainer exec --workspace-folder . ./dev "$@"
fi

# --- Ab hier: wir sind im Container --------------------------------------------

# Bewusst `mvn` (das system-installierte, per apt in post-create.sh auf 3.8.7
# gepinnte Maven), nicht `./mvnw`: der Wrapper zieht sich Maven 3.9.9, dessen
# Default-Surefire (3.2.5) sich anders verhaelt als das System-Maven-Default
# (2.12.4) -- mit JUnit 5 waere das der Unterschied zwischen "laeuft" und
# "Tests run: 0, gruen". Mit JUnit 4 laufen zwar beide, aber nur eine der
# beiden Versionen ist tatsaechlich gegen dieses Repo geprueft.
case "${1:-}" in
build)
	echo -e "${GREEN}Building (skip tests)...${NC}"
	mvn -B -ntp package -DskipTests
	;;
test)
	echo -e "${GREEN}Testing...${NC}"
	mvn -B -ntp test
	;;
check)
	echo -e "${GREEN}Full check (tests)...${NC}"
	mvn -B -ntp test
	# Prueft, dass jeder [impl->req~...] in *Test.java auf eine Anforderung
	# unter docs/specs/ aufloest (Kette kaputt -> Exit 1) und dass die Pruefung
	# selbst ueberhaupt gelaufen ist (Aufruf-/Selbstpruefungsfehler -> Exit 2,
	# der gefaehrlichere Fall: ein Zweier hier hiesse "Pruefung lief nicht",
	# nicht "Kette sauber"). `set -e` reicht beide Exit-Codes unveraendert nach
	# aussen. Kein --source noetig: alle @Test-Methoden dieses Repos leben
	# direkt in *Test.java-Dateien, es gibt kein Abstract*Testcase-Muster wie
	# in java-predicates.
	echo -e "${GREEN}Checking requirement <-> test chain...${NC}"
	python3 bin/traceability/traceability.py --spec-root docs --source-root .
	;;
*) usage ;;
esac
